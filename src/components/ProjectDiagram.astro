---
interface Props { steps: string[]; label: string; slug: string; }
const { steps, label, slug } = Astro.props;
---

<figure class="diagram term reveal">
  <figcaption class="term-bar"><span>{`MN://${slug} — ${label}`}</span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></figcaption>
  <div class="term-body">
    <p class="diagram-prompt"><span class="t-prompt">$</span> <span class="t-cmd">trace</span> <span class="t-str">{`"${slug}"`}</span></p>
    <ol class="route-diagram">
      {steps.map((step, index) => (
        <li>{index > 0 && <span class="route-sep" aria-hidden="true">→</span>}<span class="route-step">{step}</span></li>
      ))}
    </ol>
  </div>
</figure>

<style>
  .diagram { margin: 0; }
  .diagram-prompt { margin: 0 0 .7rem; }
  .route-diagram { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem .75rem; margin: 0; padding: 0; list-style: none; }
  .route-diagram li { display: inline-flex; align-items: center; gap: .55rem .75rem; min-width: 0; }
  .route-step { border: 1px solid var(--term-border); background: var(--term-bg-deep); padding: .3rem .6rem; color: var(--term-text); overflow-wrap: anywhere; }
  .route-sep { color: var(--term-accent); }

  @media (max-width: 700px) {
    .route-diagram, .route-diagram li { flex-direction: column; align-items: flex-start; }
    /* the arrow glyph is real text; rotating it turns → into ↓ when stacked */
    .route-sep { transform: rotate(90deg); }
    .route-step { width: 100%; }
  }
</style>
