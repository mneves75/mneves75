---
import SignalTrace from '../components/SignalTrace.astro';
import Terminal from '../components/Terminal.astro';
import { href, localeConfig, nav, pad, projects, site, type Locale } from '../data/site';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentPath: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { locale, title, description, currentPath, type = 'website', noindex = false } = Astro.props;
const withTrailingSlash = (path: string) => {
  const normalized = `/${path}`.replace(/\/{2,}/g, '/').replace(/\/$/, '');
  return normalized ? `${normalized}/` : '/';
};
const pagePath = href(locale, currentPath);
const canonicalPath = withTrailingSlash(pagePath);
const canonical = `${site.domain}${canonicalPath}`;
const otherLocale: Locale = locale === 'en' ? 'pt' : 'en';
const alternatePath = locale === 'pt'
  ? currentPath.replace(/^\/pt-br/, '') || '/'
  : currentPath;
const alternateUrl = `${site.domain}${withTrailingSlash(href(otherLocale, alternatePath))}`;
const defaultPath = locale === 'pt' ? alternatePath : currentPath;
const defaultUrl = `${site.domain}${withTrailingSlash(defaultPath)}`;
const person = {
  '@type': 'Person',
  name: site.name,
  url: site.domain,
  jobTitle: locale === 'en' ? 'Software Developer · Data Analyst · AI Builder' : 'Desenvolvedor de software · Analista de dados · Builder de IA',
  sameAs: [site.github, site.linkedin, site.x],
};
// ProfilePage is for pages whose main subject is the person; every other page is a WebPage by him.
const profilePage = !noindex && (currentPath === '/' || currentPath === '/about/');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': profilePage ? 'ProfilePage' : 'WebPage',
  name: title,
  url: canonical,
  inLanguage: localeConfig[locale].html,
  ...(profilePage ? { mainEntity: person } : { author: person }),
};
const lang = localeConfig[locale];
const pageKind = noindex ? 'other' : currentPath === '/' ? 'home' : currentPath === '/work/' ? 'work' : currentPath.startsWith('/work/') ? 'project' : currentPath === '/about/' ? 'about' : currentPath === '/recommendations/' ? 'recommendations' : currentPath === '/contact/' ? 'contact' : 'other';
const ogImage = `${site.domain}${locale === 'pt' ? '/og-image-pt.png' : '/og-image.png'}`;
const ogImageAlt = locale === 'en' ? 'Marcus Neves — software, data and AI' : 'Marcus Neves — software, dados e IA';
const ui = locale === 'en'
  ? { pages: 'Pages', projects: 'Projects', actions: 'Actions', home: 'Home', github: 'Open GitHub', linkedin: 'Open LinkedIn', x: 'Open X', language: 'Switch language', theme: 'Switch theme', motion: 'Pause animations', terminal: 'Open terminal', palette: 'Open command palette', search: 'Search pages, projects, actions…', noResults: 'No match', navigate: 'navigate', open: 'open', close: 'close' }
  : { pages: 'Páginas', projects: 'Projetos', actions: 'Ações', home: 'Início', github: 'Abrir GitHub', linkedin: 'Abrir LinkedIn', x: 'Abrir X', language: 'Mudar idioma', theme: 'Alternar tema', motion: 'Pausar animações', terminal: 'Abrir terminal', palette: 'Abrir paleta de comandos', search: 'Buscar páginas, projetos, ações…', noResults: 'Nada encontrado', navigate: 'navegar', open: 'abrir', close: 'fechar' };
---

<!doctype html>
<html lang={lang.html}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f0eee9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e0d" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="en" href={locale === 'en' ? canonical : alternateUrl} />
      <link rel="alternate" hreflang="pt-BR" href={locale === 'pt' ? canonical : alternateUrl} />
      <link rel="alternate" hreflang="x-default" href={defaultUrl} />
      <meta property="og:url" content={canonical} />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/archivo-100-900-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Marcus Neves" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'pt_BR'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'pt_BR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{title}</title>
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <script is:inline>
      // Restore theme and the motion choice before first paint; no theme attribute means the CSS system-preference fallback wins.
      {
        let motionPaused = false;
        try {
          const savedTheme = localStorage.getItem('mn-theme');
          if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme;
          motionPaused = localStorage.getItem('mn-motion') === 'off';
        } catch {}
        // Motion is opt-in: reduced-motion users and anyone who paused it never receive hidden initial states.
        if (!motionPaused && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.dataset.motion = 'on';
      }
    </script>
  </head>
  <body class={`page-${pageKind}`}>
    <a class="skip-link" href="#main">{locale === 'en' ? 'Skip to content' : 'Pular para o conteúdo'}</a>
    <header class="site-header">
      <div class="header-row">
        <a class="brand" href={href(locale, '/')}>
          <span class="brand-chip" aria-hidden="true">MN</span>
          <span>mvneves<span class="tld">.dev</span></span>
        </a>
        <nav class="nav" aria-label={locale === 'en' ? 'Primary navigation' : 'Navegação principal'}>
          {nav.map((item, index) => {
            const itemHref = href(locale, item.path);
            const active = currentPath === item.path || currentPath.startsWith(`${item.path}`);
            return <a href={itemHref} aria-current={active ? 'page' : undefined}><span class="idx" aria-hidden="true">{pad(index + 1)}</span><span>{item[locale]}</span></a>;
          })}
        </nav>
        <div class="header-tools">
          <a class="header-control" href={href(otherLocale, alternatePath)} aria-label={otherLocale === 'en' ? 'EN — switch to English' : 'PT — mudar para português'}>{localeConfig[otherLocale].short}</a>
          <button class="header-control" type="button" data-theme-toggle aria-label={ui.theme}>◐</button>
          <button class="header-control motion-control" type="button" data-motion-toggle aria-pressed="false" aria-label={ui.motion}><span aria-hidden="true" class="motion-glyph"></span></button>
          <button class="header-control" type="button" data-command-open aria-haspopup="dialog" aria-label={'⌘K — ' + ui.palette}>⌘K</button>
        </div>
      </div>
    </header>

    <main id="main" class="page-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <SignalTrace />
      <div class="footer-row">
        <span>MN://{locale === 'en' ? 'software / data / AI' : 'software / dados / IA'}</span>
        <div class="footer-links">
          <a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
          <a href={href(otherLocale, alternatePath)}>{localeConfig[otherLocale].label}</a>
        </div>
      </div>
    </footer>

    <dialog class="command-palette" id="command-palette" aria-labelledby="palette-title">
      <div class="palette-inner">
        <div class="term-bar"><span id="palette-title">MN://{locale === 'en' ? 'palette' : 'paleta'}</span><span class="dots" aria-hidden="true"><i></i></span></div>
        <input class="palette-search" data-palette-search type="search" aria-label={ui.search} aria-controls="palette-list" placeholder={ui.search} autocomplete="off" enterkeyhint="go" />
        <div class="palette-list" id="palette-list" data-palette-list>
          <p class="palette-group" data-palette-group>{ui.actions}</p>
          <button type="button" data-palette-terminal data-palette-item>{ui.terminal}<span>mn</span></button>
          <button type="button" data-palette-theme data-palette-item>{ui.theme}<span aria-hidden="true">◐</span></button>
          <button type="button" data-palette-motion data-palette-item>{ui.motion}<span aria-hidden="true">❚❚</span></button>
          <a href={href(otherLocale, alternatePath)} data-palette-item>{ui.language}<span>{localeConfig[otherLocale].short}</span></a>
          <a href={site.github} target="_blank" rel="noreferrer" data-palette-item>{ui.github}<span aria-hidden="true">↗</span></a>
          <a href={site.linkedin} target="_blank" rel="noreferrer" data-palette-item>{ui.linkedin}<span aria-hidden="true">↗</span></a>
          <a href={site.x} target="_blank" rel="noreferrer" data-palette-item>{ui.x}<span aria-hidden="true">↗</span></a>
          <p class="palette-group" data-palette-group>{ui.pages}</p>
          <a href={href(locale, '/')} data-palette-item>{ui.home}<span>/</span></a>
          {nav.map((item) => <a href={href(locale, item.path)} data-palette-item>{item[locale]}<span>{item.path}</span></a>)}
          <p class="palette-group" data-palette-group>{ui.projects}</p>
          {projects.map((project) => <a href={href(locale, `/work/${project.slug}/`)} data-palette-item>{project.title}<span>{project.kicker[locale]}</span></a>)}
          <p class="palette-empty" data-palette-empty hidden>{ui.noResults}</p>
        </div>
        <div class="palette-hint" aria-hidden="true"><span>↑↓ {ui.navigate} · ↵ {ui.open}</span><span>Esc {ui.close}</span></div>
      </div>
    </dialog>

    <Terminal locale={locale} />

    <script>
      // MN://runtime — theme, palette, header state, reveals, scramble,
      // count-up, magnetic. All motion respects reduced-motion.
      const root = document.documentElement;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(pointer: fine)').matches;

      // --- Theme ---
      const themeColors = { light: '#f0eee9', dark: '#0e0e0d' } as const;
      const applyThemeColor = (theme: 'light' | 'dark') => {
        // Media-scoped theme-color metas follow the OS, not the manual override.
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => meta.setAttribute('content', themeColors[theme]));
      };
      const setTheme = (theme: 'light' | 'dark') => {
        root.dataset.theme = theme;
        applyThemeColor(theme);
        // Storage can be blocked (private mode, cookie policy) — the theme still applies.
        try { localStorage.setItem('mn-theme', theme); } catch { /* noop */ }
      };
      if (root.dataset.theme === 'light' || root.dataset.theme === 'dark') applyThemeColor(root.dataset.theme);
      const effectiveTheme = (): 'light' | 'dark' =>
        root.dataset.theme === 'light' || root.dataset.theme === 'dark'
          ? root.dataset.theme
          : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const toggleTheme = () => setTheme(effectiveTheme() === 'light' ? 'dark' : 'light');
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', toggleTheme);

      // --- Motion pause (WCAG 2.2.2): every looping animation is gated on data-motion='on' ---
      const motionOn = () => root.dataset.motion === 'on';
      const motionToggles = document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle], [data-palette-motion]');
      const syncMotionToggle = () => motionToggles.forEach((toggle) => toggle.setAttribute('aria-pressed', String(!motionOn())));
      const toggleMotion = () => {
        if (reducedMotion) return; // the OS preference wins; the controls are hidden for these users
        const pause = motionOn();
        if (pause) delete root.dataset.motion;
        else root.dataset.motion = 'on';
        try { localStorage.setItem('mn-motion', pause ? 'off' : 'on'); } catch { /* noop */ }
        syncMotionToggle();
      };
      syncMotionToggle();
      document.querySelector('[data-motion-toggle]')?.addEventListener('click', toggleMotion);

      // --- Command palette ---
      const palette = document.querySelector<HTMLDialogElement>('#command-palette');
      const search = document.querySelector<HTMLInputElement>('[data-palette-search]');
      // Reduced-motion users never see the pause action (CSS hides it), so it must not take focus or count as a match.
      const paletteItems = [...document.querySelectorAll<HTMLElement>('[data-palette-item]')]
        .filter((item) => !(reducedMotion && item.matches('[data-palette-motion]')));
      const visibleItems = () => paletteItems.filter((item) => !item.hidden);
      const filterPalette = () => {
        const value = (search?.value ?? '').toLowerCase().trim();
        paletteItems.forEach((item) => {
          item.hidden = Boolean(value) && !(item.textContent ?? '').toLowerCase().includes(value);
        });
        // Group labels only make sense while browsing the full list.
        document.querySelectorAll<HTMLElement>('[data-palette-group]').forEach((group) => { group.hidden = Boolean(value); });
        const empty = document.querySelector<HTMLElement>('[data-palette-empty]');
        if (empty) empty.hidden = visibleItems().length > 0;
      };
      const openPalette = () => {
        // One modal at a time: the palette and the terminal never stack.
        if (!palette || document.querySelector('dialog[open]')) return;
        if (search) search.value = '';
        filterPalette();
        palette.showModal();
        search?.focus();
      };
      document.querySelector('[data-command-open]')?.addEventListener('click', openPalette);
      document.querySelector('[data-palette-theme]')?.addEventListener('click', () => { toggleTheme(); palette?.close(); });
      document.querySelector('[data-palette-motion]')?.addEventListener('click', () => { toggleMotion(); palette?.close(); });
      document.querySelector('[data-palette-terminal]')?.addEventListener('click', () => {
        palette?.close();
        document.dispatchEvent(new CustomEvent('mn:terminal-open'));
      });
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && !event.altKey && event.key.toLowerCase() === 'k') { event.preventDefault(); openPalette(); }
      });
      search?.addEventListener('input', filterPalette);
      palette?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          // A search field with text would swallow the first Esc to clear itself; close in one press.
          event.preventDefault();
          palette.close();
          return;
        }
        const items = visibleItems();
        if (!items.length) return;
        const index = items.indexOf(document.activeElement as HTMLElement);
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          const step = event.key === 'ArrowDown' ? 1 : -1;
          // From the search field, ArrowDown enters the list and ArrowUp wraps to its end.
          const next = index === -1 ? (step === 1 ? 0 : items.length - 1) : (index + step + items.length) % items.length;
          items[next]?.focus();
        } else if (event.key === 'Enter' && search && document.activeElement === search && search.value.trim()) {
          // Enter runs the first match only for a real query: on an empty list the first item is the hidden terminal.
          event.preventDefault();
          items[0]?.click();
        }
      });
      // A click on the dialog element itself is a click on the backdrop.
      palette?.addEventListener('click', (event) => { if (event.target === palette) palette.close(); });

      // --- Header shrink after scroll ---
      const onScroll = () => {
        if (window.scrollY > 24) root.dataset.scrolled = '';
        else delete root.dataset.scrolled;
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // --- Scroll reveals (.reveal → .is-in, once) ---
      if (motionOn() && 'IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              revealObserver.unobserve(entry.target);
            }
          }
        }, { rootMargin: '0px 0px -10% 0px' });
        document.querySelectorAll('.reveal').forEach((target) => {
          target.classList.add('reveal-pending');
          revealObserver.observe(target);
        });
      }

      // --- Scramble/decoder ---
      const GLYPHS = '!<>-_\\/[]{}—=+*^?#█▓▒░01';
      function scrambleTo(el: HTMLElement, next: string, duration = 700) {
        const from = el.textContent ?? '';
        const len = Math.max(from.length, next.length);
        const start = performance.now();
        function frame(now: number) {
          const p = Math.min(1, (now - start) / duration);
          let out = '';
          for (let i = 0; i < len; i++) {
            const reveal = i / len < p * 1.4 - 0.2;
            out += reveal || p === 1 ? (next[i] ?? '') : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
          }
          el.textContent = out;
          if (p < 1) requestAnimationFrame(frame);
          else el.textContent = next;
        }
        requestAnimationFrame(frame);
      }

      document.querySelectorAll<HTMLElement>('[data-scramble-cycle]').forEach((el) => {
        let words: string[] = [];
        try { words = JSON.parse(el.dataset.scrambleCycle ?? '[]'); } catch { /* leave static */ }
        if (words.length < 2) return;
        if (reducedMotion) { el.textContent = words[0] ?? ''; return; }
        let i = 0;
        setInterval(() => {
          if (!motionOn()) return; // paused: keep the current word still
          i = (i + 1) % words.length;
          scrambleTo(el, words[i] ?? '');
        }, 3200);
      });

      // --- Count-up [data-countup] ---
      const countObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          countObserver.unobserve(el);
          const raw = el.dataset.countup ?? '0';
          const target = parseFloat(raw);
          const suffix = el.dataset.suffix ?? '';
          if (!motionOn()) { el.textContent = raw + suffix; return; }
          const start = performance.now();
          const dur = 1400;
          function tick(now: number) {
            const p = Math.min(1, (now - start) / dur);
            const eased = 1 - Math.pow(1 - p, 4);
            el.textContent = Math.round(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-countup]').forEach((el) => countObserver.observe(el));

      // --- Magnetic buttons [data-magnetic] ---
      if (finePointer && !reducedMotion) {
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            if (!motionOn()) return;
            const r = el.getBoundingClientRect();
            const x = ((e.clientX - r.left) / r.width - 0.5) * 10;
            const y = ((e.clientY - r.top) / r.height - 0.5) * 8;
            el.style.transform = `translate(${x}px, ${y}px)`;
          });
          el.addEventListener('mouseleave', () => { el.style.transform = ''; });
        });
      }

      // --- Console hint ---
      console.log(
        '%cMN://OS%c — the projects are the evidence.\n%cpsst: type "mn" on any page. // psst: digite "mn" em qualquer página.',
        'font-family:monospace;font-size:18px;font-weight:bold;color:#c8481f',
        'font-family:monospace;color:#999',
        'font-family:monospace;color:#666'
      );
    </script>
  </body>
</html>
