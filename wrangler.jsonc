{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "mvneves-dev",
  "compatibility_date": "2026-08-09",
  "routes": [
    { "pattern": "mvneves.dev", "custom_domain": true },
    // www serves the same assets; every page's canonical URL points at the apex.
    // A dashboard Redirect Rule (www -> apex 301) can replace this later.
    { "pattern": "www.mvneves.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "staging": {
      "name": "mvneves-dev-staging",
      // Named envs inherit top-level "routes" — override so staging never claims the prod custom domains.
      "routes": [],
      "workers_dev": true
    }
  }
}
