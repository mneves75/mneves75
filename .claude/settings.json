{
  "permissions": {
    "deny": [
      "Edit(./src/data/sitemap-lastmod.json)",
      "Edit(./src/data/og-covers.json)"
    ],
    "ask": [
      "Bash(*wrangler deploy)",
      "Bash(*wrangler deploy --env=\"\"*)",
      "Bash(*wrangler deploy --env=''*)",
      "Bash(*wrangler deploy --config*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler rollback*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'bun run check && bun run build && bun run test'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
